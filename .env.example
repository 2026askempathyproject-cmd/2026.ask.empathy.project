# 이 파일을 복사해서 ".env" 파일을 만들고 실제 값을 입력하세요.
#   (Windows) copy .env.example .env
# .env는 .gitignore에 등록되어 있어 깃허브에 절대 올라가지 않습니다.

# ─────────────────────────────────────────────
# 1. Gemini API 키  ★서버 전용 — 브라우저에 절대 노출되지 않음★
#    Google AI Studio(https://aistudio.google.com/apikey)에서 무료 발급
#    절대 VITE_ 접두사를 붙이지 마세요. 붙이는 순간 브라우저에 노출됩니다.
# ─────────────────────────────────────────────
GEMINI_API_KEY=여기에_발급받은_키_입력

# 선택: 사용할 모델 (미지정 시 최신 flash 모델을 자동으로 찾아 사용)
# GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────
# 2. Firebase 웹 설정 (자료실·웹앱 저장용)
#    Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정에서 복사
#    VITE_ 접두사가 붙어 브라우저에 포함됩니다. Firebase 웹 설정값은
#    원래 공개용 식별자라 안전하며, 보안은 Firestore/Storage 규칙이 담당합니다.
#
#    ★ Vercel 배포 시 아래 6개를 Vercel Environment Variables에도 등록하세요.
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────
# 3. 관리자 구글 계정 (이 계정으로만 자료 수정 가능)
#    ★ 여기 값만으로는 보안이 되지 않습니다. 반드시 Firestore/Storage
#      보안 규칙에도 같은 이메일을 넣으세요 (README 참고).
# ─────────────────────────────────────────────
VITE_ADMIN_EMAIL=

# ─────────────────────────────────────────────
# 4. 파일 저장소 (Vercel Blob) ★서버 전용★
#    Vercel → Storage → Blob 저장소를 만들면 배포 환경에는 자동 등록됩니다.
#    내 컴퓨터에서 업로드를 테스트하려면 Vercel의 Blob 저장소 화면에서
#    토큰을 복사해 아래에 넣으세요. (없으면 '링크 등록'만 사용 가능)
# ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
